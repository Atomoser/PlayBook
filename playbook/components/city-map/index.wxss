:host, .viewport, .map-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.viewport {
  position: relative;
  overflow: hidden;
}

.map-canvas { position: absolute; z-index: 0; inset: 0; }
.map-preview { position: absolute; inset: 0; width: 100%; height: 100%; }

.map-error { position: absolute; z-index: 1; top: 45%; left: 15%; width: 70%; color: #555; text-align: center; }
.map-status { position: absolute; z-index: 1; top: 16rpx; left: 26rpx; padding: 12rpx 18rpx; border-radius: 24rpx; background: #ffffffee; color: #555; font-size: 23rpx; }
